      ]}
    ],
    "databases": [
      {
        "title": "프로젝트 태스크",
        "is_inline": true,
        "properties": {
          "태스크": "title",
          "상태": "status",
          "담당자": "rich_text",
          "우선순위": {"type": "select", "options": [
            {"name": "높음", "color": "red"},
            {"name": "중간", "color": "yellow"},
            {"name": "낮음", "color": "green"}
          ]},
          "기한": "date",
          "카테고리": {"type": "select", "options": [
            {"name": "기획", "color": "blue"},
            {"name": "개발", "color": "green"},
            {"name": "디자인", "color": "purple"},
            {"name": "QA", "color": "orange"}
          ]},
          "D-Day": {"type": "formula", "expression": "if(empty(prop(\"기한\")), \"\", format(dateBetween(prop(\"기한\"), now(), \"days\")) + \"일 남음\")"}
        },
        "views": [
          {"type": "board", "title": "칸반 보드", "group_by": {"property": "상태"}},
          {"type": "timeline", "title": "타임라인"},
          "table"
        ],
