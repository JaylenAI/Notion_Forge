# ===========================================
# NotionForge 환경변수 설정
# ===========================================
# 이 파일을 .env로 복사 후 값을 채워주세요
# cp .env.example .env

# -------------------------------------------
# Notion API (필수)
# -------------------------------------------
# Notion Integration 토큰 (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_xxxxxxxxxxxx

# 템플릿을 생성할 부모 페이지 ID
# URL에서 추출: https://notion.so/My-Page-{이부분이ID}
NOTION_PARENT_PAGE_ID=

# -------------------------------------------
# AI API (우선순위: Claude > Groq > Gemini > Mock)
# 하나 이상 설정하면 AI 모드, 없으면 Mock 모드로 동작
# -------------------------------------------
# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# 사용 모델 (기본: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Groq API 키 (https://console.groq.com, 무료)
GROQ_API_KEY=

# Gemini API 키 (https://aistudio.google.com, 무료)
GEMINI_API_KEY=

# -------------------------------------------
# 서버 설정
# -------------------------------------------
BACKEND_PORT=9500
FRONTEND_PORT=9501

# -------------------------------------------
# 선택 사항
# -------------------------------------------
# Unsplash API (커버 이미지 자동 검색용, 무료)
UNSPLASH_ACCESS_KEY=

# 로그 레벨
LOG_LEVEL=INFO
