# ===========================================
# NotionForge 환경변수 설정
# ===========================================
# 이 파일을 .env로 복사 후 값을 채워주세요
# cp .env.example .env

# -------------------------------------------
# Notion API (필수)
# -------------------------------------------
# Notion Integration 토큰 (https://www.notion.so/my-integrations)
NOTION_API_KEY=ntn_xxxxxxxxxxxx

# 템플릿을 생성할 부모 페이지 ID
# URL에서 추출: https://notion.so/My-Page-{이부분이ID}
NOTION_PARENT_PAGE_ID=

# -------------------------------------------
# AI Provider (priority: Claude > Gemini > Groq > Mock)
# Only one is needed. The first available key is used.
# 하나 이상 설정하면 AI 모드, 없으면 Mock 모드로 동작
# -------------------------------------------
# Claude (paid, best quality)
ANTHROPIC_API_KEY=

# 사용 모델 (기본: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini (free, good quality)
GEMINI_API_KEY=

# Groq (free, fast)
GROQ_API_KEY=

# -------------------------------------------
# 서버 설정
# -------------------------------------------
BACKEND_PORT=9500
FRONTEND_PORT=9501

# -------------------------------------------
# 선택 사항
# -------------------------------------------
# Unsplash API (커버 이미지 자동 검색용, 무료)
UNSPLASH_ACCESS_KEY=

# 로그 레벨
LOG_LEVEL=INFO

# -------------------------------------------
# Notion Internal API (선택 — 전체 너비 설정용)
# -------------------------------------------
# 브라우저 → 개발자도구(F12) → Application → Cookies → notion.so → token_v2 값
# 설정하면 생성된 페이지가 자동으로 전체 너비로 설정됨
NOTION_TOKEN_V2=

# -------------------------------------------
# Notion OAuth (선택 — 토큰 복붙 대신 OAuth 연동)
# -------------------------------------------
# Notion Integration 설정 > OAuth 활성화 후 발급
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:9500/api/oauth/callback
