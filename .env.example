# ===========================================
# NotionForge 환경변수 설정
# ===========================================
# 이 파일을 .env로 복사 후 값을 채워주세요
# cp .env.example .env

# -------------------------------------------
# Notion API (필수)
# -------------------------------------------
# 1. https://www.notion.so/my-integrations 에서 Integration 생성
# 2. 토큰 복사 후 아래에 붙여넣기
NOTION_API_KEY=ntn_xxxxxxxxxxxx

# 3. 템플릿을 생성할 노션 페이지를 열고 URL에서 ID 추출
#    https://notion.so/My-Page-{이부분이ID}
# 4. 해당 페이지에서 ... 메뉴 > 연결 추가 > 위에서 만든 Integration 선택
NOTION_PARENT_PAGE_ID=

# -------------------------------------------
# AI Provider (택 1 — 우선순위: Copilot > Claude > Gemini > Groq)
# -------------------------------------------

# GitHub Copilot (무료 — GitHub Copilot 구독자용, API 키 불필요)
# Copilot 구독이 있으면 자동 활성화됩니다
COPILOT_ENABLED=true
COPILOT_MODEL=gpt-4.1

# Claude (유료, 최고 품질)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini (무료, 일 20회 제한)
GEMINI_API_KEY=

# Groq (무료, 빠름, 8K TPM 제한)
GROQ_API_KEY=

# -------------------------------------------
# 서버 설정
# -------------------------------------------
BACKEND_PORT=9500
FRONTEND_PORT=9501
# 프론트엔드 URL (OAuth 리디렉트, 배포 시 변경 필요)
FRONTEND_URL=http://localhost:9501

# -------------------------------------------
# 선택 사항
# -------------------------------------------
# Unsplash API (커버 이미지 자동 검색용, 무료)
UNSPLASH_ACCESS_KEY=

# 로그 레벨
LOG_LEVEL=INFO

# Rate Limiting (분당 최대 요청 수)
RATE_LIMIT_RPM=60

# CORS 허용 오리진 (JSON 배열 형식)
CORS_ORIGINS=["http://localhost:9501","http://localhost:3000"]

# AI 모델 (provider별 기본 모델 — 비우면 코드 기본값)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_MODEL=claude-sonnet-4-6

# 품질·비용 (Phase A1/A4/B1/5)
ENABLE_LLM_JUDGE=true
JUDGE_REPAIR_ENABLED=true
QUALITY_GATE_ENABLED=false
QUALITY_GATE_MIN_SCORE=60
MAX_LLM_CALLS_PER_SESSION=40

# -------------------------------------------
# 고급 설정 (기본값 그대로 사용 권장)
# -------------------------------------------
# 입력 검증
INPUT_MIN_LENGTH=2
INPUT_MAX_LENGTH=2000

# Approval Gate 타임아웃 (초)
APPROVAL_TIMEOUT_SECONDS=60

# Gen-Eval 재시도 횟수
GEN_EVAL_MAX_RETRIES=3

# -------------------------------------------
# Notion OAuth (선택 — 토큰 복붙 대신 OAuth 연동)
# -------------------------------------------
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URI=http://localhost:9500/api/oauth/callback
